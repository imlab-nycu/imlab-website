{
  "name": "imlab-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0",
    "deploy-local": "rsync -avh --delete --exclude='.git/' --exclude='.github/' --exclude='README.md' dist/ ../imlab-nycu.github.io/",
    "publish": "cd ../imlab-nycu.github.io && git add . && git commit -m \"Website update\" && git push"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^6.4.6",
    "typescript": "^6.0.3"
  }
}
